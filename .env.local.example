# 한국은행 ECOS Open API 인증키 (https://ecos.bok.or.kr/api/ 에서 무료 발급)
# 전월세 전환율 계산기가 기준금리를 실시간으로 조회할 때 사용합니다.
# 키가 없어도 앱은 동작하지만, 마지막으로 수동 확인해둔 값으로 대체됩니다(README "2." 참고).
ECOS_API_KEY=

# 채널톡(Channel Talk) CS 챗봇 플러그인 키
# https://channel.io 콘솔 로그인 > 설정 > 설치 연동(Plugin Key)에서 발급.
# 비어있으면 채널톡 위젯이 조용히 비활성화될 뿐 앱은 정상 동작합니다.
NEXT_PUBLIC_CHANNEL_TALK_PLUGIN_KEY=

# PostHog 계측 (2026-09-04 R-11)
# https://posthog.com 프로젝트 생성 후 Project Settings > Project API Key.
# 비어있으면 계측이 조용히 꺼질 뿐 앱은 정상 동작합니다.
# ※ 배포가 둘입니다. calc-realty.vercel.app(루트, 안드로이드 앱 연결)과
#   realtybook.retools.kr/calc(embed) 양쪽 Vercel 프로젝트에 모두 넣어야 합니다.
NEXT_PUBLIC_POSTHOG_KEY=
# 클라우드 지역 주소. 미국이면 비워도 되고, 유럽이면 https://eu.i.posthog.com 을 넣습니다.
NEXT_PUBLIC_POSTHOG_HOST=
